<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 per McNeel guidance: net8.0 (default runtime from Rhino 8.20, Windows + Mac)
         and net48 (Windows, when Rhino is started with /netfx). -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Single source of truth for the release version (assembly, Yak package and git tag v<Version>). -->
    <Version>0.3.0-beta.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>Numbat</Title>
    <Company>Tom Dufficy</Company>
    <Description>Architectural productivity tools</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The RhinoCommon version sets the minimum supported Rhino (Yak tag rh8_21). Raise it only on purpose. -->
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The nbGFA how-to lives in docs/ (readable on GitHub) and is shown in Rhino by nbGFAHelp and the window's ? button. -->
    <EmbeddedResource Include="..\..\..\docs\nbGFA.md" LogicalName="Numbat.Docs.nbGFA.md" />
    <!-- The nbAF guide, shown by nbAFHelp and the nbAF window's ? button. -->
    <EmbeddedResource Include="..\..\..\docs\nbAF.md" LogicalName="Numbat.Docs.nbAF.md" />
    <!-- The nbAnon guide, shown by nbAnonHelp and the ? button in the nbAnon window. -->
    <EmbeddedResource Include="..\..\..\docs\nbAnon.md" LogicalName="Numbat.Docs.nbAnon.md" />
    <!-- nbAFDemo's site: plain coordinates (see the file's header), built into Rhino geometry by the command. -->
    <EmbeddedResource Include="Commands\Analysis\NumbatAf\AfDemoSite.txt" LogicalName="Numbat.Demo.AfDemoSite.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Saved copies of the legal texts behind nbAF's rules (see docs/sources/README.md), shipped next to the
         plug-in so nbAF can open them offline. -->
    <None Include="..\..\..\docs\sources\*.pdf" Link="sources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Preview commands (Commands/Preview/) are being reworked. They are compiled into Debug builds only, so they can be
    developed and tested in Rhino but never reach a Release build, the Yak package or users. To release a command,
    move its folder back under Commands/ (see CLAUDE.md).
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Commands\Preview\**" />
  </ItemGroup>

</Project>
