<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 per McNeel guidance: net8.0 (default runtime from Rhino 8.20, Windows + Mac)
         and net48 (Windows, when Rhino is started with /netfx). -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Single source of truth for the release version (assembly, Yak package and git tag v<Version>). -->
    <Version>0.3.0-beta.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>Numbat</Title>
    <Company>Tom Dufficy</Company>
    <Description>Architectural productivity tools</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The RhinoCommon version sets the minimum supported Rhino (Yak tag rh8_21). Raise it only on purpose. -->
    <PackageReference Include="RhinoCommon" Version="8.21.25188.17001" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
